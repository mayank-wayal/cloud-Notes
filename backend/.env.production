NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-domain.com

# AWS RDS PostgreSQL Connection
DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/cloudnotes
DATABASE_SSL=true

# JWT Security - Generate secure random string
JWT_

JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AWS Configuration
# On ECS, prefer an ECS task role instead of static AWS keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET_NAME=cloudnotes-private-bucket
S3_SIGNED_URL_EXPIRES_SECONDS=300

MAX_FILE_SIZE_MB=25
